<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="NumberSlider"
           version="0.0.1"
           display-name-key="NumberSlider_Name"
           description-key="NumberSlider_Desc"
           control-type="standard">

    <!--
      Leave this disabled unless the control calls a third-party service.

      `enabled="true"` makes the control **premium**, and premium is a cost
      somebody else pays: every end user of an app containing this component
      then needs a Power Apps licence rather than an Office 365 one. Nothing
      fails to build, nothing warns at install, and the person who finds out is
      not the person who typed it — so this is worth confirming with whoever
      owns the control rather than flipping to make a `fetch` work.

      When it is genuinely enabled, list every domain. `<domain>` children are
      declarative and can be listed under `enabled="false"` too, which is the
      schema's own second example; it is the `enabled` attribute alone that
      carries the licensing consequence.

          <external-service-usage enabled="true">
            <domain>tile.example.com</domain>
          </external-service-usage>

      `npm run check` fails on `enabled="true"` with no domain, and warns on
      `enabled="true"` at all.
    -->
    <external-service-usage enabled="false" />

    <!--
      PCFHub generates the component's API reference from this file, at the tag
      of each release.

      It records `display-name-key` and `description-key` *verbatim* — it does
      not read the .resx — so a reader sees the key itself unless something
      changes it. Two ways to get readable text: keep the keys themselves
      readable, or correct them once in the hub's admin panel, where editing a
      property locks that field so later syncs leave it alone.

      The platform still resolves these against the .resx for the maker's
      properties pane, so the keys must exist there either way.
    -->
    <!--
      A number column, of whichever kind the maker stored it as: an amount
      is Currency, a score Decimal, a coordinate FP, a count a whole number.
      All four generate NumberProperty, so `raw` stays `number | null`.

      What a group costs: `type` may report the whole group, or another
      member of it, on a real form. So index.ts reads the column's kind
      from `attributes` (Precision on the fractional types, Format on a
      whole number) and trusts `type` only to forbid. Narrow the group if
      a kind here is one the control cannot honour: a type offered is a
      type the form designer calls supported.
    -->
    <type-group name="number">
      <type>Whole.None</type>
      <type>Decimal</type>
      <type>FP</type>
      <type>Currency</type>
    </type-group>
    <property name="value"
              display-name-key="value_Name"
              description-key="value_Desc"
              of-type-group="number"
              usage="bound"
              required="true" />

    <!--
      The top of a range, in a column of its own: a range is two values, and
      Dataverse has no column that holds two. Optional, so a maker who never
      chooses Range never sees a second required column; the configuration
      pane renders it as a column picker of its own. Read only when `style`
      is Range. Unmapped, it arrives as `type: null` (pcf-address-autocomplete
      measured the shape) and is never written.

      The style is a property of its own rather than "two columns mapped means
      a range" because the hub's demo shares one fixture across every preset
      and cannot present an unmapped column: inferred, every demo preset would
      be a range.
    -->
    <property name="upperValue"
              display-name-key="upperValue_Name"
              description-key="upperValue_Desc"
              of-type-group="number"
              usage="bound"
              required="false" />

    <property name="style"
              display-name-key="style_Name"
              description-key="style_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="slider">
      <value name="slider" display-name-key="style_Slider">slider</value>
      <value name="range" display-name-key="style_Range">range</value>
      <value name="stepper" display-name-key="style_Stepper">stepper</value>
      <value name="bar" display-name-key="style_Bar">bar</value>
      <value name="arc" display-name-key="style_Arc">arc</value>
    </property>

    <!--
      Blank is a real setting: the column's own declared range, and 0 to 100
      where the column declares none (a range equal to the platform's default
      for the type is "none", or a slider over two billion would move a whole
      number per pixel of nothing). A maker's range narrower than the
      column's is kept; one wider is cut to the column's, which is what the
      column will accept.
    -->
    <property name="min"
              display-name-key="min_Name"
              description-key="min_Desc"
              of-type="Decimal"
              usage="input"
              required="false" />

    <property name="max"
              display-name-key="max_Name"
              description-key="max_Desc"
              of-type="Decimal"
              usage="input"
              required="false" />

    <property name="step"
              display-name-key="step_Name"
              description-key="step_Desc"
              of-type="Decimal"
              usage="input"
              required="false" />

    <!--
      An Enum, not a TwoOptions: a TwoOptions input cannot default to on, and
      the box is on unless the maker says otherwise.
    -->
    <property name="valueBox"
              display-name-key="valueBox_Name"
              description-key="valueBox_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="show">
      <value name="show" display-name-key="valueBox_Show">show</value>
      <value name="hide" display-name-key="valueBox_Hide">hide</value>
    </property>

    <property name="unit"
              display-name-key="unit_Name"
              description-key="unit_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="bands"
              display-name-key="bands_Name"
              description-key="bands_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/NumberSlider.css" order="1" />
      <!--
        Every language the control ships.

        A .resx that exists on disk but is not listed here is not shipped, and
        nothing warns — the file is simply never packed, and the control runs
        in English for that locale while the repository looks translated.
        `npm run check` catches both that and a key missing from a language.

        Drop the ones you will not maintain. A stale translation is worse than
        an honest fallback to English, and every key added to 1033 is a key
        owed to each file listed here.

        THE ORDER IS DELIBERATE AND 1033 GOES LAST. `pcf-start` picks the .resx
        by manifest order rather than by locale: it reads whichever file is
        listed *last* and ignores the LCID and the browser language entirely.
        The platform itself ignores the order completely — a real app resolves
        from the user's provisioned language — so `npm start` is the only thing
        in the world that reads this order, and it is ordered for it. Listing
        1033 first is the tidier-looking arrangement and it makes `npm start`
        render the whole control in Japanese, which reads as a broken build.

        The consequence to remember: ADD A NEW LANGUAGE ABOVE THIS LINE, not
        below it. Appending a sixth file after 1033 silently moves the harness
        to that language, and the symptom shows up in a `npm start` session
        nobody connects to a manifest edit.
      -->
      <resx path="strings/NumberSlider.3082.resx" version="1.0.0" />
      <resx path="strings/NumberSlider.1036.resx" version="1.0.0" />
      <resx path="strings/NumberSlider.1031.resx" version="1.0.0" />
      <resx path="strings/NumberSlider.1041.resx" version="1.0.0" />
      <resx path="strings/NumberSlider.1033.resx" version="1.0.0" />
    </resources>

    <!--
      Uncomment only the features actually used. Each one becomes a permission
      prompt for the maker installing the control.

    <feature-usage>
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
