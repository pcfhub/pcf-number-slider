<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — NumberSlider.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="NumberSlider_Name" xml:space="preserve">
    <value>Number Slider</value>
  </data>
  <data name="NumberSlider_Desc" xml:space="preserve">
    <value>A slider, range, stepper or gauge for any number column.</value>
  </data>

  <data name="value_Name" xml:space="preserve">
    <value>Value</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>The number column the control reads and writes — the bottom of the range when the style is Range.</value>
  </data>

  <!--
    Runtime strings, read with context.resources.getString(). Anything the user
    can read belongs here rather than as a literal in index.ts or as an input
    property a maker hand-translates per instance.

    Add a language by copying this file — NumberSlider.3082.resx for Spanish,
    1036 French, 1031 German, 1041 Japanese — with the SAME key set, then
    listing each one under <resources> in the manifest. A key missing from one
    language falls back to the key name in that language only, which nobody
    notices until a customer does.
  -->
  <data name="NumberSlider_NoAccess" xml:space="preserve">
    <value>You do not have access to this value.</value>
  </data>
  <data name="NumberSlider_NotANumber" xml:space="preserve">
    <value>Enter a number.</value>
  </data>
  <data name="NumberSlider_WholeOnly" xml:space="preserve">
    <value>Enter a whole number.</value>
  </data>
  <data name="NumberSlider_OutOfRange" xml:space="preserve">
    <value>Enter a number from {0} to {1}.</value>
  </data>
  <data name="NumberSlider_From" xml:space="preserve">
    <value>From</value>
  </data>
  <data name="NumberSlider_To" xml:space="preserve">
    <value>To</value>
  </data>
  <data name="NumberSlider_Decrease" xml:space="preserve">
    <value>Decrease {0}</value>
  </data>
  <data name="NumberSlider_Increase" xml:space="preserve">
    <value>Increase {0}</value>
  </data>
  <data name="NumberSlider_Empty" xml:space="preserve">
    <value>No value</value>
  </data>
  <data name="NumberSlider_Unmapped" xml:space="preserve">
    <value>Choose a column for Upper value to use the Range style.</value>
  </data>
  <data name="NumberSlider_Outside" xml:space="preserve">
    <value>The saved value is outside this control's range of {0} to {1}.</value>
  </data>
  <data name="NumberSlider_Order" xml:space="preserve">
    <value>The first value cannot be greater than the second.</value>
  </data>
  <data name="upperValue_Name" xml:space="preserve">
    <value>Upper value</value>
  </data>
  <data name="upperValue_Desc" xml:space="preserve">
    <value>Range only: the number column that holds the top of the range.</value>
  </data>
  <data name="style_Name" xml:space="preserve">
    <value>Style</value>
  </data>
  <data name="style_Desc" xml:space="preserve">
    <value>How the number is shown: a slider, a range over two columns, a stepper, or a read-only bar or arc.</value>
  </data>
  <data name="style_Slider" xml:space="preserve">
    <value>Slider</value>
  </data>
  <data name="style_Range" xml:space="preserve">
    <value>Range (two columns)</value>
  </data>
  <data name="style_Stepper" xml:space="preserve">
    <value>Stepper</value>
  </data>
  <data name="style_Bar" xml:space="preserve">
    <value>Gauge: bar</value>
  </data>
  <data name="style_Arc" xml:space="preserve">
    <value>Gauge: arc</value>
  </data>
  <data name="min_Name" xml:space="preserve">
    <value>Minimum</value>
  </data>
  <data name="min_Desc" xml:space="preserve">
    <value>The lowest value. Blank: the column's own minimum, or 0.</value>
  </data>
  <data name="max_Name" xml:space="preserve">
    <value>Maximum</value>
  </data>
  <data name="max_Desc" xml:space="preserve">
    <value>The highest value. Blank: the column's own maximum, or 100.</value>
  </data>
  <data name="step_Name" xml:space="preserve">
    <value>Step</value>
  </data>
  <data name="step_Desc" xml:space="preserve">
    <value>How far one step moves the value. Blank: 1.</value>
  </data>
  <data name="valueBox_Name" xml:space="preserve">
    <value>Value box</value>
  </data>
  <data name="valueBox_Desc" xml:space="preserve">
    <value>Show a box beside the slider to type an exact value.</value>
  </data>
  <data name="valueBox_Show" xml:space="preserve">
    <value>Show</value>
  </data>
  <data name="valueBox_Hide" xml:space="preserve">
    <value>Hide</value>
  </data>
  <data name="unit_Name" xml:space="preserve">
    <value>Unit</value>
  </data>
  <data name="unit_Desc" xml:space="preserve">
    <value>Text shown after the value, such as % or km.</value>
  </data>
  <data name="bands_Name" xml:space="preserve">
    <value>Colour bands</value>
  </data>
  <data name="bands_Desc" xml:space="preserve">
    <value>Colours by threshold, lowest first, such as: 50 danger; 80 warning; 100 success.</value>
  </data>
</root>
